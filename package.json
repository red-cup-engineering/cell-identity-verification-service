{
  "name": "@red-cup-engineering/cell-identity-verification-service",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Independently verifies that public capability-cell faces bind to one canonical RMN manifest identity, returning bound, absent, or invalid for every face.",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/verify-cell-identity.mjs"
    }
  },
  "bin": {
    "verify-cell-identity": "./scripts/verify-cell-identity.mjs"
  },
  "files": [
    "scripts/",
    "content/",
    "src/",
    "types/"
  ],
  "scripts": {
    "check": "node --check src/verify-cell-identity.mjs && node --check scripts/verify-cell-identity.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@lenticule-science/rmn-semantic-conformance-die": "6.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/cell-identity-verification-service.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
